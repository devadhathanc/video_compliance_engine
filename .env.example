# =====================================================================
# AWS CONFIGURATION (Brand Guardian AI)
# =====================================================================

# --- AWS CREDENTIALS ---
AWS_ACCESS_KEY_ID="your_aws_access_key_id"
AWS_SECRET_ACCESS_KEY="your_aws_secret_access_key"
AWS_REGION="us-east-1"

# --- AWS S3 (Bucket for video processing & storage) ---
AWS_S3_BUCKET="your-compliance-audit-bucket"

# --- AWS BEDROCK (Knowledge Base Retrieval) ---
AWS_BEDROCK_KNOWLEDGE_BASE_ID="your-bedrock-kb-id"
# Optional: specify explicit data source ID if known
# AWS_BEDROCK_DATA_SOURCE_ID="your-data-source-id"

# --- GOOGLE GEMINI (LLM Auditor) ---
GOOGLE_API_KEY="your_google_api_key"
GOOGLE_MODEL="gemini-2.0-flash"

# --- LANGSMITH (Optional - Workflow Tracing) ---
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY="your-langsmith-api-key"
LANGCHAIN_PROJECT="brand-guardian-compliance"
